## 6. 修改 `_seed_reusable_outputs()`，让它复制更完整

现在 `_seed_reusable_outputs()` 会复制每个 step 的输出目录，但有几个问题：

第一，`REUSABLE_MODE_SWITCH_STEPS` 原来没有 `timeline_digest`。
第二，manifest 没有记录 `production_mode` 和 `last_web_run_options`。
第三，最好记录 `reused_common_steps`，方便前端显示“已复用公共分析”。

找到这个函数：

```python
def _seed_reusable_outputs(req: RunRequest, task_id: str, task_dir: Path) -> None:
```

建议整体替换成下面这个版本：

```python
def _seed_reusable_outputs(req: RunRequest, task_id: str, task_dir: Path) -> None:
    """
    从另一个任务复制可复用公共分析结果到当前任务目录。

    用途：
    1. 用户从“视频重组”切到“AI配音解说”
    2. 用户重新选择同一个视频，但后端自动发现已有公共分析结果
    """
    if not req.reuse_from_task_id:
        return

    # 如果当前任务已经有 manifest，说明已经初始化过，不要强行覆盖。
    if (task_dir / "manifest.json").exists():
        return

    source_task_dir = _task_dir(req.reuse_from_task_id)
    source_manifest = read_json(source_task_dir / "manifest.json", {})
    source_steps = source_manifest.get("steps", {})

    copied_steps: dict[str, Any] = {}
    copied_versions: dict[str, str] = {}

    for step in REUSABLE_MODE_SWITCH_STEPS:
        step_info = source_steps.get(step) or {}

        if step_info.get("status") not in {"success", "partial_success", "skipped"}:
            continue

        output = step_info.get("output")
        if not output:
            continue

        source_output = source_task_dir / output
        if not source_output.exists():
            continue

        # 复制整个版本目录，而不是只复制单个 json 文件
        source_copy_root = source_output.parent
        target_copy_root = task_dir / relpath(source_copy_root, source_task_dir)
        _copy_reusable_path(source_copy_root, target_copy_root)

        copied_step_info = dict(step_info)
        copied_step_info["reused_from_task_id"] = req.reuse_from_task_id
        copied_step_info["reused_from"] = relpath(source_task_dir, ROOT)

        copied_steps[step] = copied_step_info

        if step_info.get("version"):
            copied_versions[step] = step_info["version"]

    if not copied_steps:
        return

    source_video = (
        Path(req.input_video).resolve()
        if req.input_video
        else _existing_task_source_video(source_task_dir, source_manifest)
    )
    source_video_ref = relpath(source_video, task_dir)
    now = datetime.now().isoformat(timespec="seconds")

    write_json(
        task_dir / "task.json",
        {
            "task_id": task_id,
            "created_at": now,
            "source_video_original": str(source_video),
            "source_video": source_video_ref,
            "reused_from_task_id": req.reuse_from_task_id,
        },
    )

    write_json(
        task_dir / "manifest.json",
        {
            "task_id": task_id,
            "created_at": now,
            "updated_at": now,
            "source_video": source_video_ref,
            "source_video_original": str(source_video),
            "source_mode": source_manifest.get("source_mode", "single_source"),
            "source_manifest": source_manifest.get("source_manifest", ""),
            "source_videos": source_manifest.get("source_videos", []),
            "production_mode": req.production_mode,
            "current_versions": copied_versions,
            "steps": copied_steps,
            "reused_from_task_id": req.reuse_from_task_id,
            "reused_steps": list(copied_steps),
            "reused_common_steps": list(copied_steps),
            "last_web_run_options": req.model_dump(),
        },
    )
```

这个函数的作用是：新 AI 配音任务目录刚创建时，先把旧视频重组任务的公共结果复制过来。之后 `run_pipeline.py` 再启动时，`PipelineRunner._init_task()` 会发现 manifest 已存在，然后直接用里面的 source_video、steps、current_versions 继续跑。

