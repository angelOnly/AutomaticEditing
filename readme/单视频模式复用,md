## 4. 新增“自动寻找可复用任务”函数

继续新增：

```python
def _has_reusable_common_steps(manifest: dict[str, Any]) -> bool:
    """
    判断一个旧任务是否至少具备可复制的公共分析结果。
    最理想是 timeline_digest 已成功；如果没有，也允许复制已有的前置步骤。
    """
    steps = manifest.get("steps", {})

    # 最推荐复用到 timeline_digest
    if steps.get("timeline_digest", {}).get("status") in {"success", "partial_success"}:
        return True

    # 退一步：至少 ASR / vision / timeline 里有成功项
    for step in ("asr", "vision", "timeline"):
        if steps.get(step, {}).get("status") in {"success", "partial_success"}:
            return True

    return False


def _find_reusable_single_source_task(
    *,
    req: RunRequest,
    current_task_id: str,
    input_path: Path | None,
) -> str | None:
    """
    在 outputs/ 下自动寻找同一素材、同一公共分析参数的已有任务。
    找到后返回旧 task_id，后续交给 _seed_reusable_outputs 复制公共步骤。
    """
    if req.reuse_from_task_id:
        return req.reuse_from_task_id

    if not input_path:
        return None

    if not OUTPUTS_DIR.exists():
        return None

    target_key = _analysis_fingerprint_for_single_source(req, input_path)

    candidates: list[tuple[float, str]] = []

    for task_dir in OUTPUTS_DIR.iterdir():
        if not task_dir.is_dir():
            continue

        if task_dir.name == current_task_id:
            continue

        if task_dir.name == "__common__" or task_dir.name.startswith("common_"):
            continue

        manifest = read_json(task_dir / "manifest.json", {})
        if not manifest:
            continue

        # 只处理单素材任务。多素材已有 __common__ 逻辑。
        if manifest.get("source_mode", "single_source") != "single_source":
            continue

        if not _has_reusable_common_steps(manifest):
            continue

        try:
            old_source = _existing_task_source_video(task_dir, manifest)
        except Exception:
            continue

        try:
            if old_source.resolve() != input_path.resolve():
                continue
        except Exception:
            continue

        try:
            old_key = _analysis_fingerprint_from_manifest(task_dir, manifest)
        except Exception:
            continue

        if old_key != target_key:
            continue

        candidates.append((task_dir.stat().st_mtime, task_dir.name))

    if not candidates:
        return None

    # 取最新的旧任务
    candidates.sort(reverse=True)
    return candidates[0][1]
```

