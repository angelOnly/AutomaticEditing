function isSwitchingModeFromTask(taskId, productionMode) {
  if (!taskId) return false;

  const isReassemblyTask =
    taskId.includes("视频重组") || taskId.includes("highlight_reassembly");

  const isVoiceoverTask =
    taskId.includes("AI配音解说") || taskId.includes("ai_voiceover");

  if (productionMode === "ai_voiceover") return isReassemblyTask;
  if (productionMode === "highlight_reassembly") return isVoiceoverTask;

  return false;
}
```

这个改动可以让后端原有 `_prepare_mode_switched_run()` 更容易触发。
不过真正兜底还是后端自动扫描，所以前端这步是锦上添花。

