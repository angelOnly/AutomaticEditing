```

新增：

```python
def _analysis_fingerprint_for_single_source(req: RunRequest, input_path: Path | None) -> str:
    """
    单素材公共分析 fingerprint。

    注意：
    这里故意不包含 production_mode、output_mode、target_duration_seconds、voice_id。
    因为这些只影响后续成片，不影响 metadata/asr/vision/timeline/timeline_digest。
    """
    payload = {
        "video": _video_fingerprint(input_path) if input_path else None,
        "remote": _remote_video_fingerprint(req.remote_video),
        "aspect_ratio": req.aspect_ratio,
        "chunk_seconds": int(req.chunk_seconds),
        "frame_interval": int(req.frame_interval),
        "mode": req.mode or "normal",
    }
    raw = json.dumps(payload, ensure_ascii=False, sort_keys=True)
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]
```

